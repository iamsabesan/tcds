{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "dawnConfig": {
    "DisplayFullErrorStack": false,
    "ResponseCompression": {
      "IsEnabled": true,
      "EnableForHttps": true,
      "MimeTypes": [
        "text/*",
        "application/json",
        "application/json; charset=utf-8"
      ]
    },
    "ResponseCaching": {
      "IsEnabled": false,
      "SizeLimit": 0,
      "MaximumBodySize": 0
    },
    "UseHsts": false,
    "ApiVersioning": true,
    "DefaultHeaders": {
      "IsEnabled": true,
      "headers": {
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'self'",
        "X-Permitted-Cross-Domain-Policies": "none",
        "X-Powered-By": "Team7",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Server": "Systemic"
      }
    },
    "HttpsRedirection": {
      "IsEnabled": false,
      "Code": 308,
      "HttpsPort": 443
    },
    "Cors": {
      "IsEnabled": true,
      "Name": "systemic-cors-default",
      "Origins": [
        "*"
      ],
      "Headers": [
        "*"
      ],
      "Methods": [
        "*"
      ],
      "SetPreflightMaxAgeInHours": 24
    },
    "RabbitMQSettings": {
      "Host": "localhost"
    },
    "ServiceSettings": {
      "ServiceName": "DBAdmin",
      "ServiceID": "DBAdminID",
      "ServicePort": 443,
      "Scheme": "https",
      "ServiceURL": "dbadmin.boxoftech.int.in",
      "DeregisterCriticalServiceAfter": 120,
      "Interval": 60,
      "Timeout": 30
    },
    "Gateway": {
      "Address": "{{GatewayAddress}}"
    },
	"Encryption": {
      "PrivateKey": "{{PrivateKey}}"
    },
    "ConsulConfig": {
      "ConsulHostAddress": "{{ConsulHostAddress}}"
    },
    "Connection": {
      "Mssql": ""
    }
  },
  "HostAdmin": {
    "ID": "2D0C2C89-2F62-4DD0-B2EE-CBAF526D2CA0"
  }
}
