{
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u3}] ({SourceContext}) {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "RollingFile",
        "Args": {
          "pathFormat": "AppData/Logs/log-{Date}.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "shared": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341/",
          "apiKey": "Ng1XnIBNh8mZtnU0voyg"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@Properties['ActionName'] like 'Systemic%' and (@Level = 'Error' or @Level = 'Fatal' or @Level = 'Warning')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "RollingFile",
                "Args": {
                  "pathFormat": "AppData/Logs/error/error-{Date}.json",
                  "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                  "shared": true,
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@Properties['ActionName'] like 'Systemic%' and @Level = 'Information'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "RollingFile",
                "Args": {
                  "pathFormat": "AppData/Logs/info/info-{Date}.json",
                  "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                  "shared": true,
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7,
                  "fileSizeLimitBytes": 10000000
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "Contains(SourceContext, 'Serilog.AspNetCore.RequestLoggingMiddleware')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "RollingFile",
                "Args": {
                  "pathFormat": "AppData/Logs/request/request-{Date}.json",
                  "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                  "shared": true,
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7,
                  "fileSizeLimitBytes": 10000000
                }
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "AppConfig": {
    "AllowMultipleIPToken": false,
    "AllowMultipleUserAgent": false
  },
  "JwtConfig": {
    "Secret": "SystemicIsNowBoT@2022",
    "Iss": "Box of Tech Private Limited",
    "Aud": "Box of TECH",
    "CheckLifeTime": true,
    "ValidateIssuerSigningKey": true
  },
  "IdentityService": {
    "URL": "https://identity.boxoftech.int.in/api/Identity"
  },
  "Encryption": {
    "PrivateKey": "BOXOFTECH@2022@415"
  },
  "AllowedHosts": "*"
}
