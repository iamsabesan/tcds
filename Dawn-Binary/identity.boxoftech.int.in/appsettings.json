{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DawnConfig": {
    "DisplayFullErrorStack": false,
    "ResponseCompression": {
      "IsEnabled": true,
      "EnableForHttps": true,
      "MimeTypes": [
        "text/*",
        "application/json",
        "application/json; charset=utf-8"
      ]
    },
    "ResponseCaching": {
      "IsEnabled": false,
      "SizeLimit": 0,
      "MaximumBodySize": 0
    },
    "UseHsts": false,
    "ApiVersioning": true,
    "DefaultHeaders": {
      "IsEnabled": true,
      "headers": {
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'self'",
        "X-Permitted-Cross-Domain-Policies": "none",
        "X-Powered-By": "Team7",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Server": "Systemic"
      }
    },
    "HttpsRedirection": {
      "IsEnabled": false,
      "Code": 307,
      "HttpsPort": 7183
    },
    "Cors": {
      "IsEnabled": true,
      "Name": "systemic-cors-default",
      "Origins": [
        "*"
      ],
      "Headers": [
        "*"
      ],
      "Methods": [
        "*"
      ],
      "SetPreflightMaxAgeInHours": 24
    },
    "RabbitMQSettings": {
      "Host": "localhost"
    },
    "ServiceSettings": {
      "ServiceName": "Identity",
      "ServiceID": "IdentityID",
      "Scheme": "https",
      "ServiceURL": "identity.boxoftech.int.in",
      "ServicePort": 443,
      "DeregisterCriticalServiceAfter": 120,
      "Interval": 60,
      "Timeout": 30
    },
	"Encryption": {
      "PrivateKey": "{{EncryptionKey}}"
    },
    "Gateway": {
      "Address": "{{GateWayName}}"
    },
    "ConsulConfig": {
      "ConsulHostAddress": "{{ConsulHostAddress}}"
    },
    "Connection": {
      "Mssql": "Data Source="
    }
  },
  "IdentityConfig": {
    "JwtConfig": {
      "Secret": "{{Secretkey}}",
      "Iss": "{{CompanyName}}",
      "TokenExpireMinutes": 60,
      "RefTokenExpireMinutes": 20160,
      "Aud": "{{CompanyName}}"
    },
    "AppSessionConfig": {
      "AllowMultipleAgent": true,
      "AllowMultipleIP": true,
      "AllowMultiSession": true
    }
  }
}
