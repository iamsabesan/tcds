<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.web>
    <httpCookies httpOnlyCookies="true" />
    <!-- Other configuration settings -->
    <compilation tempDirectory="C:\Inetpub\vhosts\boxoftech.int.in\tmp" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Block access to specific files -->
        <hiddenSegments>
          <add segment="package.json" />
          <add segment="composer.json" />
          <add segment="package-lock.json" />
          <add segment="LICENSE.txt" />
          <add segment="phpunit.xml" />
          <add segment="README.md" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="https://mail-v1.boxoftech.int.in/" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE" />
        <add name="Access-Control-Allow-Headers" value="Content-Type" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self';" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="Imported Rule 1" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>