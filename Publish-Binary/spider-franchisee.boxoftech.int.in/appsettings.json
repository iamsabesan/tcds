{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DawnConfig": {
    "DisplayFullErrorStack": false,
    "ApiVersioning": true,
    "ResponseCompression": {
      "IsEnabled": true,
      "EnableForHttps": true,
      "MimeTypes": [
        "text/*",
        "application/json",
        "application/json; charset=utf-8"
      ]
    },
    "Gateway": {
	  "Address": "{{GatewayAddress}}"
    },
    "ConsulConfig": {
      "ConsulHostAddress": "http://localhost:8500/"
    },
    "ResponseCaching": {
      "IsEnabled": false,
      "SizeLimit": 0,
      "MaximumBodySize": 0
    },
    "UseHsts": true,
    "DefaultHeaders": {
      "IsEnabled": true,
      "headers": {
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'self'",
        "X-Permitted-Cross-Domain-Policies": "none",
        "X-Powered-By": "Team7",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Server": "Systemic"
      }
    },
    "HttpsRedirection": {
      "IsEnabled": false,
      "Code": 307,
      "HttpsPort": 7183
    },
    "Cors": {
      "IsEnabled": true,
      "Name": "systemic-cors-default",
      "Origins": [
        "*"
      ],
      "Headers": [
        "*"
      ],
      "Methods": [
        "*"
      ],
      "SetPreflightMaxAgeInHours": 24
    },
    "RabbitMQSettings": {
      "Host": "localhost"
    },
    "ServiceSettings": {
      "ServiceName": "SpiderFranchisee",
      "ServiceID": "SpiderFranchiseeID",
      "Scheme": "https",
      "ServiceURL": "spider-franchisee.boxoftech.int.in",
      "ServicePort": 443,
      "DeregisterCriticalServiceAfter": 120,
      "Interval": 60,
      "Timeout": 30
    },
    "Connection": {
      "Mssql": "Data Source=OPTIMUS\\MSSQLSERVER2019;Initial Catalog=realtor_v2;Persist Security Info=True;User ID=mlm_team;Password=india_123;TrustServerCertificate=Yes;"
    },
    "Encryption": {
      "PrivateKey": "{{PrivateKey}}"
    }
  },
  "AllowedHosts": "*"
}